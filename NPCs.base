filters:
  and:
    - file.tags.contains("npc")
views:
  - type: table
    name: Table
    order:
      - file.name
      - pronounced
      - condition
      - race
      - gender
      - age
      - alignment
      - occupation
      - location
      - groups
      - religions
      - bond
      - dislikes
      - flaw
      - goals
      - ideal
      - likes
      - personality
    sort:
      - property: condition
        direction: DESC
    columnSize:
      note.age: 146
