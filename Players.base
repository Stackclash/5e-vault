filters:
  and:
    - file.tags.contains("player")
formulas:
  strength: abilityScores.strength.value
  dexterity: abilityScores.dexterity.value
  constitution: abilityScores.constitution.value
  intelligence: abilityScores.intelligence.value
  wisdom: abilityScores.wisdom.value
  charisma: abilityScores.charisma.value
  class: classes[0].name
views:
  - type: table
    name: Table
    order:
      - active
      - file.name
      - level
      - formula.class
      - race
      - location
      - formula.strength
      - formula.dexterity
      - formula.constitution
      - formula.intelligence
      - formula.wisdom
      - formula.charisma
      - ac
    sort: []
    summaries: {}
    columnSize:
      note.level: 143
  - type: cards
    name: Cards
    order:
      - file.name
      - race
      - ac
      - alignment
      - hp
    cardSize: 260
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.55
