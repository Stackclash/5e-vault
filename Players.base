filters:
  and:
    - file.tags.contains("player")
formulas:
  strength: abilityScores.strength.value
  dexterity: abilityScores.dexterity.value
  constitution: abilityScores.constitution.value
views:
  - type: table
    name: Table
    order:
      - file.name
      - level
      - race
      - location
      - formula.strength
      - formula.dexterity
      - formula.constitution
    summaries: {}
    columnSize:
      note.level: 143
  - type: cards
    name: Cards
    order:
      - file.name
      - race
      - ac
      - alignment
      - hp
    cardSize: 260
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.55
  - type: list
    name: View 2
