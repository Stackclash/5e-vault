filters:
  and:
    - file.tags.contains("npc")
formulas:
  religions: 'relationships.filter(value.isType("object") && ["worships", "cleric-of"].contains(value.type)).map(value.target)'
  factions: 'relationships.filter(value.isType("object") && ["member", "leader", "founder", "agent", "former-member"].contains(value.type)).map(value.target)'
  relationships: party_relationships.keys().map(value + '(' + party_relationships[value] + ')').join(', ')
properties:
  formula.religions:
    displayName: religions
  formula.factions:
    displayName: factions
  formula.relationships:
    displayName: party relationships
views:
  - type: table
    name: Overview
    filters:
      and:
        - "!formula.relationships.isEmpty()"
    order:
      - file.name
      - pronounced
      - condition
      - race
      - gender
      - age
      - alignment
      - occupation
      - location
      - formula.relationships
      - formula.factions
      - formula.religions
      - description
      - history
      - personality
      - ideal
      - bond
      - flaw
      - likes
      - dislikes
      - goals
    sort: []
    columnSize:
      note.age: 146
      formula.relationships: 247
  - type: table
    name: Party Relationships
    filters:
      and:
        - party_relationships.keys().contains('Midnight Covenant')
    order:
      - file.name
      - pronounced
      - condition
      - race
      - gender
      - age
      - alignment
      - occupation
      - location
      - formula.relationships
      - formula.factions
      - formula.religions
      - description
      - history
      - personality
      - ideal
      - bond
      - flaw
      - likes
      - dislikes
      - goals
    sort: []
    columnSize:
      note.pronounced: 245
      note.race: 128
      note.age: 146
      formula.relationships: 247
  - type: table
    name: Edit
    filters:
      and:
        - '!file.inFolder("5. Mechanics")'
        - '!file.inFolder("z_Templates")'
    order:
      - file.name
      - condition
      - gist
      - race
      - gender
      - age
      - alignment
      - location
    sort:
      - property: location
        direction: ASC
      - property: file.name
        direction: ASC
