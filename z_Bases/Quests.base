filters:
  and:
    - file.hasTag("quest")
    - '!file.inFolder("5. Mechanics")'
    - '!file.inFolder("z_Templates")'
views:
  - type: table
    name: Edit
    order:
      - file.name
      - kind
      - gist
      - deadline
    sort:
      - property: parent
        direction: ASC
      - property: file.name
        direction: ASC
