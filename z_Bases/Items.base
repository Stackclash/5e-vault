filters:
  and:
    - file.tags.contains("item")
views:
  - type: table
    name: Overview
    filters:
      and:
        - rarity.isEmpty()
    order:
      - file.name
      - type
      - subtype
      - tier
      - rarity
      - weight
      - cost
      - attunement
      - attunement-requirement
      - stealth-penalty
      - strength-requirement
      - armorClass
      - one-hand-damage
      - two-hand-damage
      - damage-type
      - range
    columnSize:
      note.weight: 112
      note.cost: 116
      note.armorClass: 134
      note.range: 88
      note.tier: 87
