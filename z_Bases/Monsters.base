filters:
  and:
    - file.tags.contains("monster")
views:
  - type: table
    name: Overview
    order:
      - file.name
      - alignment
      - size
      - cr
      - hp
      - ac
      - type
      - environments
    sort: []
  - type: table
    name: Aberrations
    filters:
      and:
        - type == "aberration"
    order:
      - file.name
      - alignment
      - size
      - cr
      - hp
      - ac
      - type
      - environments
  - type: table
    name: Beasts
    filters:
      and:
        - type == "beast"
    order:
