filters:
  and:
    - file.folder.startsWith("5. Mechanics/Bestiary")
    - file.ext == "md"
views:
  - type: table
    name: Table
    filters:
      and:
        - environments.contains("grassland")
    order:
      - file.name
      - alignment
      - size
      - cr
      - hp
      - ac
      - type
      - environments
    sort:
      - property: cr
        direction: DESC
