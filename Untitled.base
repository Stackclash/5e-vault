filters:
  and:
    - file.tags.contains("player")
formulas:
  strength: abilityScores.strength.value
views:
  - type: table
    name: Table
    order:
      - file.name
      - level
      - race
      - location
      - formula.strength
    sort:
      - property: file.name
        direction: ASC
      - property: formula.strength
        direction: DESC
  - type: cards
    name: View
    order:
      - file.name
      - race
      - ac
      - alignment
    cardSize: 260
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.55
  - type: list
    name: View 2
