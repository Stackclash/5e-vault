filters:
  and:
    - file.tags.contains("player")
views:
  - type: table
    name: Table
    order:
      - file.name
      - level
      - race
      - location
  - type: cards
    name: View
    order:
      - file.name
      - race
      - ac
      - alignment
    cardSize: 260
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.55
