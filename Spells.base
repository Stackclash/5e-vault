filters:
  and:
    - file.tags.contains("spell")
formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    order:
      - file.name
      - school
      - level
      - verbal
      - somatic
      - material
      - material_desc
      - ritual
      - range
      - time
      - saving_throw
      - formula.Untitled
    sort:
      - property: level
        direction: DESC
