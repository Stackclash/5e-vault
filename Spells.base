filters:
  and:
    - file.tags.contains("spell")
    - file.folder == "5. Mechanics/Spells"
formulas:
  Untitled: saving_throw.skills.join(', ')
  saving thow success: saving_throw.succeeds
  area shape: area.shape
  area size: if(area.size, area.size + ' ft', '')
summaries:
  Unique: values.unique().length
properties:
  note.material_desc:
    displayName: material description
  formula.Untitled:
    displayName: saving throw skills
views:
  - type: table
    name: Table
    order:
      - file.name
      - school
      - level
      - verbal
      - somatic
      - material
      - material_desc
      - ritual
      - range
      - time
      - formula.Untitled
      - formula.saving thow success
      - formula.area shape
      - formula.area size
    sort:
      - property: level
        direction: ASC
    summaries: {}
