filters:
  and:
    - file.tags.contains("spell")
    - file.folder == "5. Mechanics/Spells"
formulas:
  Untitled: saving_throw.skills.join(', ')
  saving thow success: saving_throw.succeeds
properties:
  note.material_desc:
    displayName: material description
  formula.Untitled:
    displayName: saving throw skills
views:
  - type: table
    name: Table
    order:
      - file.name
      - school
      - level
      - verbal
      - somatic
      - material
      - material_desc
      - ritual
      - range
      - time
      - formula.Untitled
      - formula.saving thow success
    sort:
      - property: level
        direction: ASC
  - type: table
    name: View
